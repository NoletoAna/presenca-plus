@page
@model PresencaPlus.Pages.Relatorio.IndexModel
@{
    ViewData["Title"] = "Relatório de frequência";
}

<h1 class="h3 mb-3">Relatório de frequência</h1>

<form method="get" class="row g-2 mb-3 d-print-none">
    <div class="col-12 col-md-4">
        <label for="TurmaId" class="form-label">Turma</label>
        <select id="TurmaId" name="TurmaId" class="form-select" asp-items="Model.Turmas"></select>
    </div>
    <div class="col-6 col-md-3">
        <label for="De" class="form-label">Data inicial</label>
        <input id="De" name="De" type="date" class="form-control" value="@Model.De?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-6 col-md-3">
        <label for="Ate" class="form-label">Data final</label>
        <input id="Ate" name="Ate" type="date" class="form-control" value="@Model.Ate?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-12 col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Gerar</button>
    </div>
</form>

@if (Model.Erro is not null)
{
    <div class="alert alert-warning" role="alert">@Model.Erro</div>
}

<p>
    Turma: <strong>@Model.NomeTurma</strong>.
    Período: @Model.De?.ToString("dd/MM/yyyy") a @Model.Ate?.ToString("dd/MM/yyyy").
    Mínimo exigido: 75%.
</p>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr><th>Aluno</th><th>Matrícula</th><th>Aulas</th><th>Faltas</th><th>Frequência</th><th>Situação</th></tr>
        </thead>
        <tbody>
            @foreach (var l in Model.Linhas)
            {
                var classe = l.Situacao switch
                {
                    "Abaixo de 75%" => "table-danger",
                    "Atenção" => "table-warning",
                    _ => ""
                };
                <tr class="@classe">
                    <td>@l.Aluno.Nome</td>
                    <td>@l.Aluno.Matricula</td>
                    <td>@l.Aulas</td>
                    <td>@l.Faltas</td>
                    <td>@(l.Percentual is null ? "—" : l.Percentual.Value.ToString("F1") + "%")</td>
                    <td>@l.Situacao</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Linhas.Count == 0)
{
    <p class="text-muted">Nenhum aluno encontrado para esta turma.</p>
}

<button type="button" class="btn btn-outline-secondary d-print-none" onclick="window.print()">Imprimir</button>
