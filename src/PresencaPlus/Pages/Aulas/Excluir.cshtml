@page "{id:int}"
@model PresencaPlus.Pages.Aulas.ExcluirModel
@{
    ViewData["Title"] = "Excluir aula";
}

<h1 class="h3 mb-3">Excluir aula</h1>

<p>
    Aula: <strong>@Model.Aula.Disciplina</strong>, @Model.Aula.Turma.Nome,
    @Model.Aula.Data.ToString("dd/MM/yyyy") às @Model.Aula.Horario.ToString("HH:mm")
</p>

@if (Model.Impedimento is not null)
{
    <div class="alert alert-warning" role="alert">@Model.Impedimento</div>
    <a class="btn btn-outline-secondary" asp-page="Index">Voltar</a>
}
else
{
    <p>Confirma a exclusão desta aula?</p>
    <form method="post">
        <button type="submit" class="btn btn-danger">Excluir</button>
        <a class="btn btn-outline-secondary" asp-page="Index">Cancelar</a>
    </form>
}
