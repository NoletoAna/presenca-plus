<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Presença+</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PresencaPlus.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="d-print-none">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" href="/">Presença+</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                            aria-expanded="false" aria-label="Abrir menu">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            @if (User.IsInRole("Coordenacao"))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" href="/Turmas">Turmas</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" href="/Alunos">Alunos</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" href="/Aulas">Aulas</a></li>
                            }
                            @if (User.IsInRole("Professor"))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" href="/Chamada">Minhas aulas</a></li>
                            }
                            <li class="nav-item"><a class="nav-link text-dark" href="/Relatorio">Relatório</a></li>
                        </ul>
                        <form method="post" action="/Sair" class="d-flex align-items-center gap-2">
                            @Html.AntiForgeryToken()
                            <span class="navbar-text">@User.Identity.Name</span>
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Sair</button>
                        </form>
                    </div>
                }
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
