@model Turma

<div class="mb-3">
    <label asp-for="Nome" class="form-label"></label>
    <input asp-for="Nome" class="form-control" />
    <span asp-validation-for="Nome" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="AnoLetivo" class="form-label"></label>
    <input asp-for="AnoLetivo" class="form-control" />
    <span asp-validation-for="AnoLetivo" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Turno" class="form-label"></label>
    <select asp-for="Turno" class="form-select">
        <option value="">Selecione</option>
        <option>Matutino</option>
        <option>Vespertino</option>
        <option>Noturno</option>
    </select>
    <span asp-validation-for="Turno" class="text-danger"></span>
</div>
