@page
@model PresencaPlus.Pages.Turmas.CriarModel
@{
    ViewData["Title"] = "Nova turma";
}

<h1 class="h3 mb-3">Nova turma</h1>

<form method="post" class="col-12 col-md-6">
    <partial name="_Form" for="Turma" />
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a class="btn btn-outline-secondary" asp-page="Index">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
