@page
@model PresencaPlus.Pages.LoginModel
@{
    ViewData["Title"] = "Entrar";
}

<div class="row justify-content-center">
    <div class="col-12 col-sm-8 col-md-5">
        <h1 class="h3 mb-3">Entrar no Presença+</h1>

        @if (Model.Erro is not null)
        {
            <div class="alert alert-danger" role="alert">@Model.Erro</div>
        }

        <form method="post">
            <div class="mb-3">
                <label asp-for="UsuarioLogin" class="form-label"></label>
                <input asp-for="UsuarioLogin" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="UsuarioLogin" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Senha" class="form-label"></label>
                <input asp-for="Senha" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Senha" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Entrar</button>
        </form>
    </div>
</div>
