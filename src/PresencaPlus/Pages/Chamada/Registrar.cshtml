@page "{id:int}"
@model PresencaPlus.Pages.Chamada.RegistrarModel
@{
    ViewData["Title"] = "Registrar chamada";
}

<h1 class="h3 mb-1">Registrar chamada</h1>
<p class="text-muted">
    @Model.Aula.Turma.Nome, @Model.Aula.Disciplina,
    @Model.Aula.Data.ToString("dd/MM/yyyy") às @Model.Aula.Horario.ToString("HH:mm")
</p>

@if (Model.Impedimento is not null)
{
    <div class="alert alert-warning" role="alert">@Model.Impedimento</div>
    <a class="btn btn-outline-secondary" asp-page="Index">Voltar</a>
}
else
{
    <p>Todos começam presentes. Marque somente os alunos que faltaram.</p>

    <form method="post">
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr><th>Matrícula</th><th>Aluno</th><th class="text-center">Faltou</th></tr>
                </thead>
                <tbody>
                    @foreach (var aluno in Model.Alunos)
                    {
                        <tr>
                            <td>@aluno.Matricula</td>
                            <td><label for="falta-@aluno.Id">@aluno.Nome</label></td>
                            <td class="text-center">
                                <input id="falta-@aluno.Id" class="form-check-input" type="checkbox" name="Faltantes"
                                       value="@aluno.Id" checked="@Model.Faltantes.Contains(aluno.Id)" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <button type="submit" class="btn btn-primary">Salvar chamada</button>
        <a class="btn btn-outline-secondary" asp-page="Index">Cancelar</a>
    </form>
}
