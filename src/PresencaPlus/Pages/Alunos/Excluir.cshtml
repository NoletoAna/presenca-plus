@page "{id:int}"
@model PresencaPlus.Pages.Alunos.ExcluirModel
@{
    ViewData["Title"] = "Excluir aluno";
}

<h1 class="h3 mb-3">Excluir aluno</h1>

<p>Aluno: <strong>@Model.Aluno.Nome</strong> (matrícula @Model.Aluno.Matricula)</p>

@if (Model.Impedimento is not null)
{
    <div class="alert alert-warning" role="alert">@Model.Impedimento</div>
    <a class="btn btn-outline-secondary" asp-page="Index">Voltar</a>
}
else
{
    <p>Confirma a exclusão deste aluno?</p>
    <form method="post">
        <button type="submit" class="btn btn-danger">Excluir</button>
        <a class="btn btn-outline-secondary" asp-page="Index">Cancelar</a>
    </form>
}
